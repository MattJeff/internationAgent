# Every var here is read by agentos-server/src/config.rs. The server refuses to
# boot if a required one is missing — keep this file and that struct in lockstep.

APP_BIND=0.0.0.0:8090
# The origin this deployment is reachable at. Include the scheme: Twilio signs
# its inbound callbacks over the URL itself, and the string checked here is
# `${PUBLIC_HOST}/v1/webhooks/{path}` — so a value that disagrees with what was
# pasted into the provider's console answers every genuine text message 401.
# A value with no scheme is read as https.
PUBLIC_HOST=https://agents.example.com
AGENT_EMAIL_DOMAIN=agents.example.com

DATABASE_URL=postgres://postgres:postgres@localhost:5442/agentos

# 32-byte hex key that wraps per-tenant secrets locally. Swapped for AWS KMS in
# production; the envelope format and AAD are already KMS-shaped.
AGENTOS_MASTER_KEY=

# Refuses to boot with mock provider adapters unless this is explicitly set.
# It means "I accept that the adapters named in the refusal do nothing." Every
# boot logs one line saying what is behind each port; /readyz publishes the same
# list as `mock_adapters` for as long as the replica is up.
AGENTOS_ALLOW_MOCKS=1

# Each of these SELECTS the real adapter. Unset means the mock beside it, which
# needs AGENTOS_ALLOW_MOCKS above. Per adapter: one set and two unset is a
# normal deployment, not an error.
#
# Two are compound because the adapter takes two values, and half of one is a
# boot failure rather than a client that 401s at 3am. The email adapter's
# `whsec_…` comes from AGENTOS_WEBHOOK_SECRETS below, not from a fourth
# variable, and its sending domain is AGENT_EMAIL_DOMAIN above.
#
# There is deliberately no EMBEDDER_API_KEY: `Embedder` has one variant and it
# is a SHA-256 hash, so no credential could change what runs.
EMAIL_API_KEY=
# console.twilio.com -> Account SID and Auth Token
TELEPHONY_API_KEY=
# browserbase.com -> Settings -> Project ID and API key
BROWSER_API_KEY=

# The operators' keyring: `label:tenant-uuid:secret[,…]`. The label becomes the
# audit actor, and for an A2A peer it must be that peer's domain. Consulted
# BEFORE the `api_keys` table, so an entry here cannot be shadowed by a row.
# Issuing or revoking one of these is still a redeploy — for a customer's key,
# use AGENTOS_PLATFORM_KEYS below instead.
AGENTOS_API_KEYS=

# The platform credential: `label:secret[,…]`. **No tenant uuid** — it speaks
# for no tenant and can read no tenant's data. It authorises exactly
# POST /v1/platform/tenants (sign a customer up and hand them their first key)
# and POST/GET/DELETE /v1/platform/keys (issue, list and revoke a tenant's keys,
# with no restart). Unset means /v1/platform/* is 401 to everybody, which is the
# right state for a deployment that is not a control plane.
#
# A tenant's own key can NEVER reach these routes: a stolen key that could mint
# another would make revoking it pointless.
AGENTOS_PLATFORM_KEYS=

# Which provider callbacks this deployment accepts, and whose:
# `provider:tenant-uuid:signing-secret[,…]`. The provider is the `{path}`
# segment of /v1/webhooks/{path}.
#
# ONE TENANT PER PROVIDER. This is a map keyed on that segment, so two entries
# on `email` is a boot failure rather than two customers. A deployment with a
# second customer registers theirs with `POST /v1/platform/webhooks`, which
# mints an opaque path and seals the secret into `webhook_endpoints` — see
# docs/PROVIDERS.md, "More than one customer on one provider account".
#
# Unset AND an empty table means every callback is a 404 and no inbound message
# can arrive. This variable is consulted first, so a row cannot shadow it.
AGENTOS_WEBHOOK_SECRETS=

# The OAuth applications WE registered with each provider, one per connector:
# `connector:client_id:client_secret[,…]`. Deployment scope, never a tenant's —
# a client secret identifies this product to a provider and is the same value
# for every customer, so it is here and not in a table.
#
# Unset means this deployment offers no OAuth connectors, which is the current
# state: `agentos_app::catalog::CATALOG` has no OAuth entry yet and its own docs
# argue why. A connector with no registration here is not advertised by
# GET /v1/mcp/catalog at all, so nobody clicks a button that cannot work.
#
# Whatever is registered, the provider must be told our redirect URI, which is
# exactly `${PUBLIC_HOST}/v1/mcp/oauth/callback` — one per deployment, not one
# per connector.
AGENTOS_OAUTH_CLIENTS=

RUST_LOG=agentos=debug,tower_http=info
